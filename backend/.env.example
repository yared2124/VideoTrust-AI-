# VideoTrust AI Backend Environment Configuration
# PostgreSQL — matches docker-compose videotrust-db service (for local Docker dev)
DATABASE_URL="postgresql://videotrust_user:secure_password_123@localhost:5432/videotrust"
REDIS_URL="redis://localhost:6379"
NODE_ENV="development"
CACHE_TTL_DAYS=30
PORT=4000
HOST="0.0.0.0"

# Optional: Google Gemini API Key for dynamic LLM summaries
GEMINI_API_KEY=""

# Optional: VideoTrust Auth Secret for MCP/Admin
VIDEOTRUST_API_KEY="vt_live_dev_secret_key"
