{
  "manifest_version": 3,
  "name": "VideoTrust AI — YouTube Integrity & Trust Intelligence",
  "version": "1.0.0",
  "description": "Real-time AI trust scoring, clickbait divergence detection, and audience sentiment drawer directly inside YouTube.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://localhost:4000/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "all_frames": false,
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "VideoTrust AI"
  }
}
